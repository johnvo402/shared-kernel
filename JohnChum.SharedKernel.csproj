<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.2.3</Version>
		<Authors>JohnVo</Authors>
		<Description>My shared kernel for domain-driven design</Description>
		<PackageTags>SharedKernel,DDD,NuGet</PackageTags>
		<RepositoryUrl>https://github.com/johnvo402/shared-kernel</RepositoryUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Ulid" Version="1.3.4" />
		<PackageReference Include="Mediator.Abstractions" Version="3.0.0-preview.27" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
		<PackageReference Include="Ardalis.GuardClauses" Version="4.6.0" />

	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>